# Local API key: replace this placeholder with your own random key.
AUTHORIZATION=replace-with-your-local-api-key
API_PREFIX=

# ChatGPT upstream. Put account access tokens in data/token.txt, one per line.
CHATGPT_BASE_URL=https://chatgpt.com
PROXY_URL=
IMPERSONATE=["chrome123"]
HISTORY_DISABLED=true
RETRY_TIMES=0
RANDOM_TOKEN=false
AUTO_SEED=true
SCHEDULED_REFRESH=false
ENABLE_GATEWAY=false

# Local console login. Generate a PBKDF2 hash as described in README.md.
# Keep the hash single-quoted to preserve dollar signs in Docker Compose.
LOCAL_CONSOLE_ENABLED=true
LOCAL_CONSOLE_USERNAME=admin
LOCAL_CONSOLE_PASSWORD_HASH=''

# Read-only quota refresh interval (seconds); 0 disables automatic refresh.
LOCAL_QUOTA_AUTO_REFRESH_SECONDS=300
