# Local API key: replace this placeholder with your own random key.
AUTHORIZATION=replace-with-your-local-api-key
API_PREFIX=

# ChatGPT upstream. Put account access tokens in data/token.txt, one per line.
CHATGPT_BASE_URL=https://chatgpt.com
PROXY_URL=
IMPERSONATE=["chrome123"]
HISTORY_DISABLED=true
AUTO_SEED=true
# Quota scheduling applies to shared local API keys with AUTO_SEED=true.
ACCOUNT_QUOTA_SCHEDULING=true
# Maximum different accounts per request (1-10); only safe failures can switch.
ACCOUNT_MAX_ATTEMPTS=3
# Legacy account selection only, when quota scheduling is inactive.
RANDOM_TOKEN=false
SCHEDULED_REFRESH=false
ENABLE_GATEWAY=false

# Native Image2 is separate from ChatGPT web images and needs Codex authorization.
# Leave disabled for chatgpt-image-latest; enabling does not grant account access.
CODEX_NATIVE_IMAGES_ENABLED=false

# Local console login. Generate a PBKDF2 hash as described in README.md.
# Keep the hash single-quoted to preserve dollar signs in Docker Compose.
LOCAL_CONSOLE_ENABLED=true
LOCAL_CONSOLE_USERNAME=admin
LOCAL_CONSOLE_PASSWORD_HASH=''

# Normal quota refresh interval; reset/pending states can refresh sooner.
# 0 disables background reads; manual/on-demand reads still respect cooldown.
LOCAL_QUOTA_AUTO_REFRESH_SECONDS=300
